            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"שדרות הנשיא 45\",\n  \"city\": \"חיפה\",\n  \"neighborhood\": \"מרכז הכרמל\",\n  \"asking_price_ils\": 1900000.0,\n  \"area_sqm\": 105.0,\n  \"rooms\": 4.0,\n  \"floor\": 3,\n  \"estimated_monthly_rent_ils\": 6800.0,\n  \"is_single_home\": true\n}"
