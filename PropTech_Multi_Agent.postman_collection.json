{
  "info": {
    "_postman_id": "a7e91f22-8b31-49d0-9123-7c5a1829e001",
    "name": "PropTech Multi-Agent Real Estate Analyzer API",
    "description": "אוסף Postman מלא למערכת מולטי-סוכנים לניתוח עסקאות והשקעות נדל\"ן (FastAPI + PostgreSQL + MongoDB RAG + HITL).\nכולל שמירה אוטומטית של jwt_token, property_id ו-run_id בין הבקשות.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "property_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "run_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Healthcheck",
      "item": [
        {
          "name": "GET /health - בדיקת תקינות השרת",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Authentication (JWT)",
      "item": [
        {
          "name": "1.1 POST /api/v1/auth/register - רישום משקיע חדש",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"investor@proptech.co.il\",\n  \"full_name\": \"דניאל כהן - משקיע נדלן\",\n  \"password\": \"StrongPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "1.2 POST /api/v1/auth/login - התחברות ושמירת JWT אוטומטית",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', jsonData.access_token);",
                  "    console.log('JWT Token saved automatically to collection variable jwt_token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"investor@proptech.co.il\",\n  \"password\": \"StrongPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        }
      ]
    },
    {
