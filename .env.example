APP_NAME="PropTech Multi-Agent Real Estate Investment Analyzer"
ENVIRONMENT="development"
DEBUG=true

# Security & JWT
JWT_SECRET_KEY="super-secret-production-proptech-jwt-key-change-me"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Databases (Dual DAL)
DATABASE_URL="postgresql+asyncpg://proptech:proptech_pass@localhost:5432/proptech_db"
MONGO_URI="mongodb://localhost:27017"
MONGO_DB_NAME="proptech_ai"
USE_IN_MEMORY_MONGO_FALLBACK=true

# External Market API & LLM Settings
MARKET_API_BASE_URL="https://api.nadlan-gov-mock.il/v1"
MARKET_API_TIMEOUT_SECONDS=8.0
OPENAI_API_KEY="sk-your-openai-key"
DEFAULT_MORTGAGE_RATE_PCT=4.85
DEFAULT_LOAN_YEARS=25
HITL_RISK_SCORE_THRESHOLD=70
